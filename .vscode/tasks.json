{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "options": {
        // Specify the cross compiler and arch in environment variable for all tasks
        "env": {
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "build_image",
            "linux": {
                "command": "${workspaceFolder}/scripts/build_image.sh"
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\build_image.ps1"
                ]
            },
            "problemMatcher": [],
            "group": {
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "run_container",
            "linux": {
                "command": "${workspaceFolder}/scripts/run_container.sh"
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\run_container.ps1"
                ]
            },
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "shell",
            "label": "build_pdf",
            "linux": {
                "command": "${workspaceFolder}/scripts/build_pdf.sh"
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}\\scripts\\build_pdf.ps1"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}
